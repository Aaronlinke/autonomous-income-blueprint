# Autonomous Income Agent - Umgebungsvariablen Beispiel
# Kopieren Sie diese Datei zu .env und tragen Sie Ihre echten API-Schlüssel ein

# =============================================================================
# GUMROAD INTEGRATION
# =============================================================================
# Gumroad Access Token (von https://app.gumroad.com/api)
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# =============================================================================
# AFFILIATE MARKETING INTEGRATIONEN
# =============================================================================
# Impact.com API Key
IMPACT_API_KEY=your_impact_api_key_here

# Awin API Key
AWIN_API_KEY=your_awin_api_key_here

# Commission Junction API Key
CJ_API_KEY=your_cj_api_key_here

# =============================================================================
# OPENAI INTEGRATION (für Content-Generierung)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# WORDPRESS INTEGRATION (für automatisches Posting)
# =============================================================================
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_PASSWORD=your_wp_app_password

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================
# Google Analytics Tracking ID
GA_TRACKING_ID=UA-XXXXXXXXX-X
# oder für GA4:
# GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# EMAIL MARKETING
# =============================================================================
# Mailchimp API Key
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# SMTP Konfiguration (Alternative zu Mailchimp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# =============================================================================
# SOCIAL MEDIA INTEGRATION
# =============================================================================
# Twitter API (für automatisches Posten)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# =============================================================================
# SERVER KONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=production

# =============================================================================
# SICHERHEIT
# =============================================================================
# JWT Secret für Authentifizierung (falls implementiert)
JWT_SECRET=your_super_secret_jwt_key_here

# =============================================================================
# ANWEISUNGEN ZUM EINRICHTEN DER API-SCHLÜSSEL
# =============================================================================

# GUMROAD:
# 1. Gehen Sie zu https://app.gumroad.com/api
# 2. Klicken Sie auf "Create an OAuth application"
# 3. Klicken Sie auf "Generate access token"
# 4. Kopieren Sie den Token in GUMROAD_ACCESS_TOKEN

# IMPACT.COM:
# 1. Loggen Sie sich in Ihr Impact.com Publisher-Konto ein
# 2. Gehen Sie zu Settings > API
# 3. Generieren Sie einen neuen API Key
# 4. Kopieren Sie den Key in IMPACT_API_KEY

# AWIN:
# 1. Loggen Sie sich in Ihr Awin Publisher-Konto ein
# 2. Gehen Sie zu Tools > API
# 3. Erstellen Sie einen neuen API Token
# 4. Kopieren Sie den Token in AWIN_API_KEY

# COMMISSION JUNCTION:
# 1. Loggen Sie sich in Ihr CJ Publisher-Konto ein
# 2. Gehen Sie zu Account > Web Services
# 3. Erstellen Sie einen neuen API Key
# 4. Kopieren Sie den Key in CJ_API_KEY

# OPENAI:
# 1. Gehen Sie zu https://platform.openai.com/api-keys
# 2. Klicken Sie auf "Create new secret key"
# 3. Kopieren Sie den Key in OPENAI_API_KEY

# WORDPRESS:
# 1. Loggen Sie sich in Ihr WordPress Admin ein
# 2. Gehen Sie zu Benutzer > Profil
# 3. Scrollen Sie zu "Anwendungspasswörter"
# 4. Erstellen Sie ein neues Anwendungspasswort
# 5. Verwenden Sie Ihren Benutzernamen und das App-Passwort

# GOOGLE ANALYTICS:
# 1. Gehen Sie zu https://analytics.google.com/
# 2. Wählen Sie Ihre Property aus
# 3. Gehen Sie zu Admin > Property Settings
# 4. Kopieren Sie die Tracking-ID oder Measurement ID

# MAILCHIMP:
# 1. Loggen Sie sich in Ihr Mailchimp-Konto ein
# 2. Gehen Sie zu Account > Extras > API keys
# 3. Erstellen Sie einen neuen API Key
# 4. Kopieren Sie den Key in MAILCHIMP_API_KEY

# TWITTER:
# 1. Gehen Sie zu https://developer.twitter.com/
# 2. Erstellen Sie eine neue App
# 3. Generieren Sie API Keys und Access Tokens
# 4. Kopieren Sie alle vier Werte

# LINKEDIN:
# 1. Gehen Sie zu https://www.linkedin.com/developers/
# 2. Erstellen Sie eine neue App
# 3. Konfigurieren Sie OAuth 2.0
# 4. Kopieren Sie Client ID, Secret und Access Token
