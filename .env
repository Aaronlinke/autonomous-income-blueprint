# Autonomous Income Agent Konfiguration

# OpenAI API Key (optional - für erweiterte KI-Funktionen)
# OPENAI_API_KEY=your_openai_api_key_here

# Affluent API (optional - für echte Affiliate-Daten)
# AFFLUENT_API_KEY=your_affluent_api_key_here
# AFFLUENT_AGENCY_NAME=your_agency_name_here

# Gumroad API (optional - für digitale Produkte)
# GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# Server Konfiguration
PORT=3001

# Agent Konfiguration
OPPORTUNITY_SEARCH_INTERVAL=4  # Stunden
MAX_OPPORTUNITIES_PER_SEARCH=20
MIN_ROI_THRESHOLD=1.5
